# Base URL of the OnlyMonkes worker API this site reads from and writes to.
# The public jumpstreet25 instance is the default — a fork can point this at
# its own worker deployment instead if it wants a fully independent backend,
# but the default is meant to work out of the box against the same Saga
# Monkes community data as the official site.
NEXT_PUBLIC_WORKER_BASE_URL=https://onlymonkes-actions.jumpstreet25.workers.dev

# Solana RPC endpoint used client-side for wallet balance/connection checks.
# A free public RPC works but rate-limits fast under real traffic — get a
# free Helius (or similar) API key for anything beyond local testing.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
